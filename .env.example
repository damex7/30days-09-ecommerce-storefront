# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored, so your keys stay on your machine.

# Paystack TEST public key (Dashboard > Settings > API Keys & Webhooks).
# It must start with pk_test_. Public keys are safe in the browser.
# NEVER put the secret key (sk_...) in any VITE_ variable: everything
# prefixed with VITE_ is bundled into the JavaScript anyone can read.
# Leave it empty to use the built-in simulated payment instead.
VITE_PAYSTACK_PUBLIC_KEY=

# Optional: the seller's WhatsApp number in international format, digits only
# (e.g. 2348031234567). Falls back to the placeholder in src/config.js.
VITE_SELLER_WHATSAPP=
